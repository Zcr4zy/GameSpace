@foreach(var console in Model){
    <div class="card" style="width: 18rem;">
    <img src="~/img/" class="card-img-top" alt="Imagem do card">
    <div class="card-body">
        <h5 class="card-title">@console.Nome</h5>
        <p class="card-text">@console.Descricao</p>
        <p class="card-text">@console.DataLancamento - @console.Geracao</p>
        <a href="#" class="btn btn-primary">Ação</a>
    </div>
    </div>

}

